# Public browser-safe Supabase values only. Never put service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets must never use the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# S14 — worker dos agentes (/api/agents/worker). Desligado por padrão.
# Só "true" liga. CRON_SECRET: 32+ caracteres aleatórios (a Vercel envia como Bearer nas chamadas do Cron).
AGENT_EXECUTOR_ENABLED=
CRON_SECRET=

# Canonical site URL used by the email confirmation callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# S6.1 — destino externo de logs (opcional; sem LOG_DRAIN_URL os logs vão só para o console/Vercel).
# Endpoint HTTPS que aceita POST JSON (um registro por requisição, já com campos sensíveis redigidos).
# LOG_DRAIN_TOKEN é enviado como "Authorization: Bearer"; é segredo, configure só no servidor.
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
# info | warn | error (padrão: warn). Timeout em ms (padrão 1500, máx. 5000).
LOG_DRAIN_LEVEL=
LOG_DRAIN_TIMEOUT_MS=
