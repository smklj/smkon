# Public browser-safe Supabase values only. Never put service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets must never use the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# S14 — worker dos agentes (/api/agents/worker). Desligado por padrão.
# Só "true" liga. CRON_SECRET: 32+ caracteres aleatórios (a Vercel envia como Bearer nas chamadas do Cron).
AGENT_EXECUTOR_ENABLED=
CRON_SECRET=
# Modelo no Vercel AI Gateway. Credencial: AI_GATEWAY_API_KEY, ou AGENT_MODEL_AUTH=oidc na Vercel (token do deployment).
# Modelos com preço cadastrado: anthropic/claude-haiku-5.5, google/gemini-3.8-flash, google/gemini-4-argon,
# openai/gpt-5-mini, anthropic/claude-opus-5.5. Para cobrar o Gemini na sua conta Google, cadastre a chave do
# Google AI Studio em Vercel → AI Gateway → Bring Your Own Key (docs/AGENTES_MODELOS.md).
AGENT_MODEL_PROVIDER=
AGENT_MODEL=
AGENT_MODEL_AUTH=
AI_GATEWAY_API_KEY=
# Teto mensal de gasto com IA do ambiente, em USD (obrigatório; o modelo precisa ter preço em model-pricing.ts).
AGENT_MONTHLY_BUDGET_USD=

# Canonical site URL used by the email confirmation callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# S6.1 — destino externo de logs (opcional; sem LOG_DRAIN_URL os logs vão só para o console/Vercel).
# Endpoint HTTPS que aceita POST JSON (um registro por requisição, já com campos sensíveis redigidos).
# LOG_DRAIN_TOKEN é enviado como "Authorization: Bearer"; é segredo, configure só no servidor.
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
# info | warn | error (padrão: warn). Timeout em ms (padrão 1500, máx. 5000).
LOG_DRAIN_LEVEL=
LOG_DRAIN_TIMEOUT_MS=

# ==============================================================================
# FRENTE E — Marketplaces, Webhooks & Afiliados Físicos e Digitais
# ==============================================================================

# S24 — Kiwify Webhook (/api/webhooks/kiwify) — DESLIGADO por padrão.
# Ainda não persiste eventos. Só ligue depois de confirmar o esquema de assinatura oficial.
# Token só em cabeçalho (x-kiwify-token / Authorization: Bearer). Segredo próprio, mínimo 16 caracteres.
KIWIFY_WEBHOOK_ENABLED=false
KIWIFY_WEBHOOK_SECRET=

# S18 — Hotmart Webhook (/api/webhooks/hotmart)
# Autenticação por conexão: o hash do Hottok fica em source_connections. Não existe segredo global.

# Shopee e Shein: sem integração oficial ainda (Affiliate Open API pendente).
# Os links de afiliado são informados pelo usuário; nada é gerado pelo SMKON.

# S19 — Metricool: credenciais por workspace, cifradas em envelope AES-256-GCM.
# Não existe token global de plataforma. Chave: 32 bytes em base64 (openssl rand -base64 32).
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_TOKEN_ENCRYPTION_KEY_ID=primary
